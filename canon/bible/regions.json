        2
      ]
    },
    "exit_order": "remaining exits sorted by target id take the rows top to bottom",
    "road_width": {
      "fat": "full height (3 rows)",
      "thin": "the one middle row"
    },
    "revisits": "the camera only moves right; returning to a roost appends it to the strip again as a new tower segment (the strip is the path taken, not the map)",
    "camera": "monotonic; a square that has scrolled off the left edge is gone for the run",
