{
  "name": "buster-whack",
  "version": "1.1.0",
  "description": "A virus-busting, whack-a-mole arcade minigame you can drop into any page as an ES module.",
  "type": "module",
  "main": "src/buster-whack.js",
  "module": "src/buster-whack.js",
  "exports": {
    ".": "./src/buster-whack.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/becker929/buster-whack.git"
  },
  "homepage": "https://github.com/becker929/buster-whack#readme",
  "bugs": {
    "url": "https://github.com/becker929/buster-whack/issues"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "npx serve .",
    "build": "esbuild src/buster-whack.js --bundle --format=esm --outfile=dist/buster-whack.js",
    "test": "npm run canon:check && npm run typecheck && npm run test:unit && npm run test:smoke",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "test:smoke": "node test/smoke.mjs",
    "visual": "node tools/visual-check.mjs",
    "visual:update": "node tools/visual-check.mjs --update",
    "visual:proof": "node tools/visual/font-proof.mjs",
    "frames": "node tools/frames.mjs",
    "canon:embed": "node tools/canon-embed.mjs",
    "canon:check": "node tools/canon-embed.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "size": "node tools/size-check.mjs",
    "test:browser": "node test/browser/touch.mjs",
    "art:check": "node tools/art-check.mjs",
    "art:dump": "node tools/art/dump.mjs",
    "art:pack": "node tools/art/pack.mjs",
    "play": "node tools/play.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.53",
    "esbuild": "^0.28.2",
    "jsdom": "^24.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "game",
    "canvas",
    "arcade",
    "widget",
    "web-component"
  ],
  "license": "MIT"
}
